<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
  <FileVersion major="1" minor="6" />
  <Project>
    <Option title="PacRipper" />
    <Option pch_mode="2" />
    <Option compiler="gcc" />
    <Build>
      <Target title="Release">
        <Option output="bin/PacRipper" prefix_auto="0" extension_auto="1" />
        <Option object_output="obj/codeblocks/frontend" />
        <Option type="1" />
        <Option compiler="gcc" />
        <Compiler>
          <Add option="-O2" />
          <Add option="-DNDEBUG" />
          <Add option="-std=c++17" />
        </Compiler>
        <Linker>
          <Add option="-lstdc++fs" />
        </Linker>
      </Target>
      <Target title="Windows Release">
        <Option output="bin/PacRipper" prefix_auto="0" extension_auto="1" />
        <Option object_output="obj/codeblocks/windows/frontend" />
        <Option type="1" />
        <Option compiler="gcc" />
        <Option platforms="Windows;" />
        <Compiler>
          <Add option="-O2" />
          <Add option="-DNDEBUG" />
          <Add option="-std=c++17" />
          <Add option="-Wall" />
          <Add option="-Wextra" />
          <Add option="-Wpedantic" />
        </Compiler>
        <Linker>
          <Add option="-static-libgcc" />
          <Add option="-static-libstdc++" />
          <Add option="-lstdc++fs" />
        </Linker>
      </Target>
      <Target title="macOS Universal Release">
        <Option output="bin/PacRipper" prefix_auto="0" extension_auto="1" />
        <Option object_output="obj/codeblocks/macos/frontend" />
        <Option type="1" />
        <Option compiler="gcc" />
        <Option platforms="Mac;" />
        <Compiler>
          <Add option="-O2" />
          <Add option="-DNDEBUG" />
          <Add option="-std=c++17" />
          <Add option="-Wall" />
          <Add option="-Wextra" />
          <Add option="-Wpedantic" />
          <Add option="-stdlib=libc++" />
          <Add option="-mmacosx-version-min=11.0" />
          <Add option="-arch" />
          <Add option="x86_64" />
          <Add option="-arch" />
          <Add option="arm64" />
        </Compiler>
        <Linker>
          <Add option="-stdlib=libc++" />
          <Add option="-mmacosx-version-min=11.0" />
          <Add option="-arch" />
          <Add option="x86_64" />
          <Add option="-arch" />
          <Add option="arm64" />
        </Linker>
      </Target>
    </Build>
    <Unit filename="src/main.cpp" />
    <Extensions>
      <code_completion />
      <envvars />
      <debugger />
    </Extensions>
  </Project>
</CodeBlocks_project_file>
